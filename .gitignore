# Build artifacts
/bin/
/dist/
*.exe
*.test
*.out

# go build ./cmd/<name> 会把二进制直接落在仓库根。
# README 教的正是这个命令，漏掉它就会有 10MB 的 ELF 被 git add -A 收进去。
/larkax
/[a-z]*ctl

# Dependencies
/vendor/

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local runtime state
/tmp/
*.log
coverage.out
coverage.html

# Node
node_modules/
web/dist/
.pnpm-store/
