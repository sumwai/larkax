.SH NAME
larkaxctl\-alias \- 模\:型\:别\:名\:映\:射\:（上\:游\:模\:型\:名 ↔ 规\:范\:名）
.SH SYNOPSIS
.B larkaxctl alias
.RI [ 选\:项 ]
.br
二\:级\:动\:作\:与\:参\:数\:见 \fBlarkaxctl alias \-\-help\fR（短\:版）\:与 \fBlarkaxctl help alias\fR（长\:版）。
.PP
模\:型\:别\:名\:映\:射\:（上\:游\:模\:型\:名 ↔ 规\:范\:名）。\:不\:带 \fB\-\-channel\fR 的\:别\:名\:是\fB平\:台\:级\fR，\:对\:所\:有\:渠\:道\:生\:效；\:带 \fB\-\-channel\fR 的\:是\:渠\:道\:级，\:只\:对\:那\:个\:渠\:道\:生\:效，\:并\:盖\:过\:同\:一\:条\:平\:台\:级\:别\:名。\:同\:一\:个\:规\:范\:名\:在\:每\:个\:范\:围\:里\:最\:多\:只\:能\:有\:一\:个\:上\:游\:名——两\:个\:上\:游\:名\:指\:向\:同\:一\:个\:规\:范\:名\:时，\:选\:路\:无\:从\:取\:舍。
.PP
\fB\-\-overrides\fR 是\:一\:组\fB上\:游\:请\:求\:参\:数\fR的\:覆\:盖，\:只\:允\:许\:三\:个\:键：\fBtemperature\fR、\fBtop_p\fR、\fBmax_tokens\fR。\:别\:的\:键\:在\:写\:入\:时\:就\:被\:拒\:绝——它\:们\:要\:么\:改\:的\:是\:请\:求\:的\:形\:状\:（\fBmodel\fR、\fBmessages\fR、\fBtools\fR、\fBstream\fR），\:要\:么\:根\:本\:不\:是\:这\:个\:请\:求\:的\:参\:数。\:与\:调\:用\:方\:冲\:突\:时\:的\:口\:径：\:调\:用\:方\fB给\:了\fR的\:采\:样\:参\:数\:以\:调\:用\:方\:为\:准，\:没\:给\:的\:取\:覆\:盖\:值；\fBmax_tokens\fR 反\:过\:来，\:一\:律\:以\:覆\:盖\:值\:为\:准。
.PP
\fBupdate\fR 按 \fB\-\-id\fR 定\:位，\fB渠\:道\:范\:围\:与\:规\:范\:名\:都\:不\:可\:改\fR：\:改\:渠\:道\:范\:围\:是\:换\:了\:一\:条\:别\:名，\:改\:规\:范\:名\:等\:于\:把\:这\:条\:别\:名\:改\:挂\:到\:另\:一\:个\:计\:费\:键\:上，\:而\:那\:样\:同\:一\:次\:请\:求\:的\:选\:路\:与\:计\:费\:会\:指\:向\:两\:个\:不\:同\:的\:模\:型。\:要\:改\:就\:删\:掉\:重\:建，\:两\:次\:改\:动\:各\:自\:看\:得\:见。
.PP
\fBresolve\fR 走\:的\:是\:请\:求\:热\:路\:径\:上\:同\:一\:条\:查\:询，\:所\:以\:「渠\:道\:级\:别\:名\:盖\:过\:平\:台\:级\:那\:条」\:这\:件\:事\:在\:这\:里\:看\:得\:见\:（\fBlist\fR 只\:是\:把\:两\:种\:范\:围\:各\:列\:一\:遍，\:不\:回\:答\:谁\:赢）。
.SH SEE ALSO
.BR larkaxctl (1)
