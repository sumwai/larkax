# 复制为 .env 并填入真实值。不要把填好的 .env 提交上来。
#
# 本文件可以直接被 shell 读取：
#   set -a && . ./.env && set +a
# 所以每个值都带引号，注释单独占行。改这个文件时请保持这个格式。
#
# 这里只有三类值：连数据库需要的、解密需要的、每个实例可能不同的。
# 其余配置项都在数据库的 settings 表里——配置跟着数据走，
# 换环境或做恢复时不需要把一堆环境变量照抄一遍。
#
# 加新环境变量前请先想清楚：它是不是必须在连上数据库之前拿到？
# 不是的话就放进 settings 表。

# 跑哪个角色：gateway（数据面）/ control（控制面）/ worker（后台任务）。
LARKAX_ROLE="gateway"

# PostgreSQL 连接串。用户名、密码、库名都在里面。
# 写 127.0.0.1 而不是 localhost：在有 IPv6 的机器上 localhost 可能解析到 ::1，
# 而本地容器通常只把端口绑在 IPv4 上，表现为「明明起着却连不上」。
#
# 本地开发时这一行由 make 维护：每次 make run / up / migrate 都会按
# DB_PASSWORD / PG_PORT / PG_DB 把它同步过去，所以换端口用
# `make run PG_PORT=55432` 就够，不必手改这里。指向非本机的库时 make 不碰它。
LARKAX_DB_DSN="postgres://larkax:<DB_PASSWORD>@127.0.0.1:5432/larkax?sslmode=disable"

# 渠道凭证的主密钥。格式 "<标识>:<base64 的 32 字节>"，多把用逗号分隔。
# 生成：openssl rand -base64 32
#
# 用多把是有意的：任何一把都能解开数据密钥，所以轮换时可以新旧并存，
# 弄丢其中一把（变量被覆盖、密钥服务迁移出错）也不会让存量数据变成废纸。
# 标识必须稳定，密文里记着它，改名等于丢数据。
LARKAX_MASTER_KEYS="current:<MASTER_KEY>,previous:<MASTER_KEY>"

# ── 以下均有默认值，按需设置 ──────────────────────────────────────────────

# 业务入口监听地址。默认 :8080
#LARKAX_HTTP_ADDR=":8080"

# 内部端点监听地址（健康检查，后续加指标）。默认 :9090
#LARKAX_INTERNAL_ADDR=":9090"

# debug / info / warn / error。默认 info
#LARKAX_LOG_LEVEL="info"

# 环境名。production 会把日志格式从文本切成 JSON（便于采集与检索）。
# 默认 development。错误详情的暴露程度尚未接进来，别指望设了它就能收紧错误输出。
#LARKAX_ENV="development"

# Redis 连接串，留空表示不启用。
#LARKAX_REDIS_DSN="redis://127.0.0.1:6379/0"
