# Copy to .env and fill in. Never commit a real .env.
#
# All values below are placeholders. Anything that looks like a credential in this
# repository must either be an environment variable reference or a placeholder.

# ── Core ──────────────────────────────────────────────────────────────────────
LARKAX_ENV=development
LARKAX_ROLE=gateway              # gateway | control | worker
LARKAX_HTTP_ADDR=:8080
LARKAX_LOG_LEVEL=debug

# ── PostgreSQL ────────────────────────────────────────────────────────────────
LARKAX_DB_DSN=postgres://larkax:<DB_PASSWORD>@localhost:5432/larkax?sslmode=disable
LARKAX_DB_MAX_CONNS=20

# ── Redis ─────────────────────────────────────────────────────────────────────
LARKAX_REDIS_ADDR=localhost:6379
LARKAX_REDIS_PASSWORD=<REDIS_PASSWORD>
LARKAX_REDIS_DB=0

# ── Channel credential encryption ─────────────────────────────────────────────
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
# In production this comes from the secrets manager, not from this file.
LARKAX_CREDENTIAL_MASTER_KEY=<CREDENTIAL_MASTER_KEY>

# ── Upstream channel credentials ──────────────────────────────────────────────
# Format: <CHANNEL_NAME>_API_KEY and optional <CHANNEL_NAME>_BASE_URL.
# Channels are also configurable in the database; these are for local development.
EXAMPLE_CHANNEL_API_KEY=<CHANNEL_CREDENTIAL>
EXAMPLE_CHANNEL_BASE_URL=https://api.example.com/v1

# ── Payment providers ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<WEBHOOK_SECRET>

# ── Observability ─────────────────────────────────────────────────────────────
LARKAX_OTEL_ENDPOINT=
LARKAX_METRICS_ADDR=:9090

# ── Frontend ──────────────────────────────────────────────────────────────────
WEB_API_BASE=http://localhost:8080
