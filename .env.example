# Copy this file to .env and fill in real values. Never commit the filled-in .env.
#
# This file is readable by the shell directly:
#   set -a && . ./.env && set +a
# so every value is quoted and every comment sits on its own line. Keep that
# shape when editing this file.
#
# Only three kinds of values belong here: what is needed to reach the database,
# what is needed to decrypt, and what may differ per instance. Everything else
# lives in the database's settings table — configuration travels with the data,
# so switching environments or restoring a backup does not mean copying a pile
# of environment variables by hand.
#
# Before adding a variable, ask: is it needed *before* the database connection
# is up? If not, it belongs in the settings table.

# Which role to run: gateway (data plane) / control (control plane) / worker (background jobs).
LARKAX_ROLE="gateway"

# PostgreSQL connection string. User, password and database name are all in it.
# 127.0.0.1 rather than localhost: on a machine with IPv6, localhost may resolve
# to ::1 while a local container publishes its port on IPv4 only — which shows up
# as "it is running but nothing can connect".
#
# During local development `make` maintains this line: every `make run` / `up` /
# `migrate` syncs it from DB_PASSWORD / PG_PORT / PG_DB, so switching ports is
# `make run PG_PORT=55432` and there is no need to edit this by hand. `make`
# leaves it alone when it points at a remote database.
LARKAX_DB_DSN="postgres://larkax:<DB_PASSWORD>@127.0.0.1:5432/larkax?sslmode=disable"

# Master keys for channel credentials. Format "<id>:<base64 of 32 bytes>",
# several keys separated by commas. Generate with: openssl rand -base64 32
#
# More than one key is deliberate: any of them can unwrap the data key, so keys
# can be rotated with the old and the new side by side, and losing one (variable
# overwritten, key service migration gone wrong) does not turn existing data into
# waste paper. The id must stay stable — ciphertexts record it, and renaming it
# means losing the data.
LARKAX_MASTER_KEYS="current:<MASTER_KEY>,previous:<MASTER_KEY>"

# ── Everything below has a default; set it only when you need to ───────────

# Public API listen address. Defaults to 127.0.0.1:8080, which binds loopback
# only — nothing outside this host can reach it. Set it explicitly to widen the
# bind, for example LARKAX_HTTP_ADDR=":8080" in a container or when the service
# must be reachable from elsewhere.
#LARKAX_HTTP_ADDR="127.0.0.1:8080"

# Internal endpoint listen address (health checks, metrics). Defaults to
# 127.0.0.1:9090, loopback only — same reasoning as above.
#LARKAX_INTERNAL_ADDR="127.0.0.1:9090"

# debug / info / warn / error. Defaults to info.
#LARKAX_LOG_LEVEL="info"

# Environment name. production switches the log format from text to JSON (easier
# to collect and search). Defaults to development. How much error detail is
# exposed is not wired up yet, so do not expect this to tighten error output.
#LARKAX_ENV="development"

# Redis connection string; empty means Redis is disabled.
#LARKAX_REDIS_DSN="redis://127.0.0.1:6379/0"
